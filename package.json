{
  "name": "undermine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "2D destructible-terrain sandbox multiplayer PWA. Inspired by the Clonk series by RedWolf Design.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "relay": "node server/relay.mjs",
    "check:sim": "node scripts/check-sim-purity.mjs",
    "check:determinism": "node scripts/determinism.mjs",
    "check:budget": "node scripts/bundle-budget.mjs",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run check:sim && npm run test && npm run check:determinism"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^2.1.4"
  }
}
